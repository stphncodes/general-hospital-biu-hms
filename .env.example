# =============================================================================
# General Hospital Biu — Hospital Information System
# Environment variable template
# =============================================================================
#
# Copy this file to `.env.local` and fill in values for your own environment:
#
#     cp .env.example .env.local
#
# NEVER commit `.env`, `.env.local` or any file containing real credentials.
# `.gitignore` excludes every `.env*` file except this template.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle at
# build time. Treat them as PUBLIC. Never put a secret in a NEXT_PUBLIC_ var.
#
# All variables are validated at runtime by `src/config/env.ts` (public) and
# `src/config/env.server.ts` (server-only). Invalid or missing required values
# fail fast with a descriptive error.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Canonical base URL of this deployment. Used to build absolute URLs such as
# auth email redirect links. No trailing slash.
# Required. Example (local): http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (public — safe to expose to the browser)
# -----------------------------------------------------------------------------

# Your Supabase project URL.
# Hosted: Project Settings → API → Project URL
# Local (`npx supabase start`): http://127.0.0.1:54321
# Required.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (format: sb_publishable_...). Replaces the legacy
# "anon" key. It is safe in the browser ONLY because every table is protected
# by Row Level Security — see docs/security/README.md.
# Hosted: Project Settings → API Keys → Publishable key
# Required.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Supabase (server-only — SECRET)
# -----------------------------------------------------------------------------

# Supabase secret key (format: sb_secret_...). Replaces the legacy
# "service_role" key. It BYPASSES Row Level Security.
#
#   * Only read in `src/lib/supabase/admin.ts`, which is guarded by
#     `server-only` so it cannot be bundled into client code.
#   * Only for privileged operations with no user context (e.g. staff
#     account provisioning). Never use it to serve a user's request data.
#   * Never prefix with NEXT_PUBLIC_. Never log it. Rotate if exposed.
#
# Required for inviting staff (admin console) and for `npm run admin:create`.
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Minimum server log level: debug | info | warn | error
# Optional. Defaults to "debug" in development and "info" otherwise.
LOG_LEVEL=
